{
  "name": "sso-mussarelos",
  "version": "0.2.0",
  "description": "SSO com Discord para Express: só entra quem é membro do servidor configurado.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*.js": {
      "sso-source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run build && node --test \"test/*.test.ts\"",
    "example": "npm run build && node --env-file=.env example/server.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "express": ">=4.18",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "pg-mem": "^3.0.0",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "discord",
    "sso",
    "oauth2",
    "express",
    "auth",
    "typescript"
  ],
  "license": "MIT"
}
